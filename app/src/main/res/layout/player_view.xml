<?xml version="1.0" encoding="utf-8"?>
<!--
  Video uses a SurfaceView (hardware overlay): on Fire TV that path gets the chip's video scaler and
  sharpening, which a TextureView loses. PlayerScreen makes the window translucent so the overlay shows.
  The black background paints the letterbox bars: with a translucent window nothing else draws there, so a
  closed overlay (e.g. the audio panel) used to linger above and below the picture. The SurfaceView still
  clears its own rectangle, so the video itself is unaffected.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="false"
    android:keepScreenOn="true"
    app:resize_mode="fit"
    app:shutter_background_color="#000000"
    app:surface_type="surface_view"
    app:use_controller="false" />
